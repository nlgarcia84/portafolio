---
interface Props {
  title: string;
  i18n?: string;
}

const { title, i18n } = Astro.props;
---

<div
  class="tilt-card rounded-[12px] border border-[rgba(255,255,255,0.06)] bg-[rgba(255,255,255,0.04)] p-6 transition-colors duration-200 hover:border-vblue/25"
>
  <h2
    class="m-0 mb-3 text-[2rem] font-semibold"
    {...i18n ? { "data-i18n": i18n } : {}}
  >
    {title}
  </h2>
  <slot />
</div>
