---
import Card from "./ui/Card.astro";

interface Props {
  title: string;
  i18n: string;
}

const { title, i18n } = Astro.props;
---

<Card class="gap-4 p-6 sm:p-8">
  <h2
    data-slot="card-title"
    class="text-xl font-semibold tracking-tight"
    data-i18n={i18n}
  >
    {title}
  </h2>
  <div data-slot="card-content"><slot /></div>
</Card>
