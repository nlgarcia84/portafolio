---
const { title = "", i18n = "", class: cls = "" } = Astro.props;
const classes = [
  "tilt-card",
  "rounded-[8px]",
  "border",
  "border-[rgba(255,255,255,0.06)]",
  "bg-[rgba(255,255,255,0.04)]",
  "p-6",
  "transition-colors",
  "duration-200",
  "hover:border-vblue/25",
  cls,
]
  .filter(Boolean)
  .join(" ");
---

<div class={classes}>
  {
    title && (
      <h2
        class="m-0 mb-3 text-[1.1rem] font-semibold"
        {...(i18n ? { "data-i18n": i18n } : {})}
      >
        {title}
      </h2>
    )
  }
  <slot />
</div>
