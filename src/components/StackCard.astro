---
import Card from "./Card.astro";

const { skills, title = "Tech stack", i18n = "stack.title" } = Astro.props;
---

<Card title={title} i18n={i18n}>
  <ul class="m-0 mt-4 flex list-none flex-wrap gap-2 p-0">
    {
      skills.map((skill) => (
        <li class="inline-flex items-center gap-1.5 rounded-md border border-vblue/10 bg-vblue/10 px-2.5 py-1 text-sm font-medium text-vblue-light">
          <img
            src={skill.icon}
            alt=""
            width="18"
            height="18"
            class="h-[18px] w-[18px]"
          />{" "}
          {skill.name}
        </li>
      ))
    }
  </ul>
</Card>
