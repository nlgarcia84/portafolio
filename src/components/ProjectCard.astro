---
import { Image } from "astro:assets";
import type { Project } from "../types";

const stackIcons: Record<string, string> = {
  Astro: "/icons/astro-original.svg",
  Tailwind: "/icons/tailwindcss-original.svg",
  "Tailwind CSS": "/icons/tailwindcss-original.svg",
  Supabase: "/icons/supabase-original.svg",
  JavaScript: "/icons/javascript-original.svg",
  Git: "/icons/github-original.svg",
  "Next.js": "/icons/nextjs-original.svg",
  "Spring Boot": "/icons/spring-original.svg",
  Java: "/icons/java-original.svg",
  TypeScript: "/icons/typescript-original.svg",
  AI: "/icons/ai-openai.svg",
};

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
---

<article
  class="group neubox overflow-hidden rounded-[12px] transition-colors duration-200"
>
  <Image
    src={project.image}
    alt={`${project.title} screenshot`}
    width={800}
    height={450}
    loading="lazy"
    class="aspect-[16/9] w-full object-cover object-top brightness-[0.7] transition-all duration-500 group-hover:scale-[1.03] group-hover:brightness-100"
  />
  <div class="p-5">
    <h3
      class="m-0 mb-1.5 text-[1rem] font-semibold"
      data-i18n={`projects.t${index}.title`}
    >
      {project.title}
    </h3>
    <p
      class="m-0 text-[0.9rem] leading-relaxed text-muted"
      data-i18n={`projects.t${index}.desc`}
    >
      {project.description}
    </p>
    <p
      class="m-0 mb-1 mt-4 text-[0.7rem] font-semibold uppercase tracking-[0.08em] text-muted"
      data-i18n="projects.stack"
    >
      Tech Stack
    </p>
    {
      (["frontend", "backend", "other"] as const).map((group) =>
        project.stack[group].length > 0 ? (
          <div class="mt-2">
            <p
              class="m-0 mb-1 text-[0.65rem] font-medium uppercase tracking-[0.08em] text-vblue-light/80"
              data-i18n={`projects.stack.${group}`}
            >
              {group}
            </p>
            <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
              {project.stack[group].map((item) => (
                <li
                  class="inline-flex items-center gap-1.5 rounded-md border border-white/10 bg-white/[0.04] px-2 py-1 text-[0.75rem] font-medium text-text/80"
                  title={item}
                >
                  {stackIcons[item] && (
                    <img
                      src={stackIcons[item]}
                      alt=""
                      width="14"
                      height="14"
                      class="h-[14px] w-[14px] shrink-0"
                      loading="lazy"
                    />
                  )}
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ) : null,
      )
    }
    <a
      class="group/btn relative mt-6 flex w-full items-center justify-center gap-2 overflow-hidden rounded-lg border border-vblue/40 bg-vblue/10 px-4 py-2.5 text-[0.9rem] font-semibold text-white no-underline transition-all duration-300 hover:scale-[1.02] hover:border-vblue hover:bg-vblue/25 hover:shadow-[0_0_25px_rgba(59,130,246,0.4)] active:scale-[0.98]"
      href={project.href}
      target="_blank"
      rel="noopener"
    >
      <span
        class="pointer-events-none absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/25 to-transparent transition-transform duration-700 ease-out group-hover/btn:translate-x-full"
      ></span>
      <span class="relative" data-i18n="projects.link"> Visit project </span>
      <svg
        class="relative h-4 w-4 shrink-0 transition-transform duration-300 group-hover/btn:translate-x-1"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17L17 7"></path>
        <path d="M7 7h10v10"></path>
      </svg>
    </a>
  </div>
</article>
