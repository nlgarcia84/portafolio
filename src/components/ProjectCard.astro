---
import { Image } from "astro:assets";
import type { Project } from "../types";

const stackIcons: Record<string, string> = {
  Astro: "/icons/astro-original.svg",
  Tailwind: "/icons/tailwindcss-original.svg",
  "Tailwind CSS": "/icons/tailwindcss-original.svg",
  Supabase: "/icons/supabase-original.svg",
  JavaScript: "/icons/javascript-original.svg",
  Git: "/icons/github-original.svg",
  "Next.js": "/icons/nextjs-original.svg",
  "Spring Boot": "/icons/spring-original.svg",
  Java: "/icons/java-original.svg",
  TypeScript: "/icons/typescript-original.svg",
  AI: "/icons/ai-openai.svg",
};

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
---

<article
  class="group neubox min-w-0 overflow-hidden rounded-[12px] transition-colors duration-200"
>
  <Image
    src={project.image}
    alt={`${project.title} screenshot`}
    width={1600}
    height={900}
    loading="lazy"
    class="aspect-[16/9] w-full object-cover object-top brightness-[0.72] transition-all duration-500 group-hover:scale-[1.03] group-hover:brightness-100"
  />
  <div class="p-6 md:p-10">
    <h3
      class="m-0 mb-1.5 text-[1rem] font-semibold break-words md:mb-2 md:text-[1.5rem]"
      data-i18n={`projects.t${index}.title`}
    >
      {project.title}
    </h3>
    <p
      class="m-0 mb-1 mt-4 text-[0.7rem] font-semibold uppercase tracking-[0.08em] text-muted md:text-[0.8rem]"
      data-i18n="projects.stack"
    >
      Tech Stack
    </p>
    {
      (["frontend", "backend", "other"] as const).map((group) =>
        project.stack[group].length > 0 ? (
          <div class="mt-2">
            <p
              class="m-0 mb-1 text-[0.65rem] font-medium uppercase tracking-[0.08em] text-vpurple/80 md:text-[0.75rem]"
              data-i18n={`projects.stack.${group}`}
            >
              {group}
            </p>
            <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
              {project.stack[group].map((item) => (
                <li
                  class="inline-flex items-center gap-1.5 rounded-md border border-white/10 bg-white/[0.04] px-2 py-1 text-[0.75rem] font-medium text-text/80 md:px-2.5 md:py-1.5 md:text-[0.85rem]"
                  title={item}
                >
                  {stackIcons[item] && (
                    <img
                      src={stackIcons[item]}
                      alt=""
                      width="14"
                      height="14"
                      class="h-[14px] w-[14px] shrink-0 md:h-4 md:w-4"
                      loading="lazy"
                    />
                  )}
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ) : null,
      )
    }
    <a
      class="mt-6 flex w-full items-center justify-center gap-2 rounded-lg border border-vpurple/40 bg-vpurple/10 px-4 py-2.5 text-[0.9rem] font-semibold text-white no-underline transition-all duration-300 hover:border-vpurple hover:bg-vpurple/25 hover:shadow-[0_0_20px_rgba(188,82,238,0.35)] md:mt-8 md:px-6 md:py-3 md:text-[1rem]"
      href={project.href}
      target="_blank"
      rel="noopener"
    >
      <span data-i18n="projects.link"> Visit project </span>
      <svg
        class="h-4 w-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17L17 7"></path>
        <path d="M7 7h10v10"></path>
      </svg>
    </a>
  </div>
</article>
