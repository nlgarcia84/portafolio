---
const { project, index = 0 } = Astro.props;
---

<article
  class="tilt-card rounded-[8px] border border-white/10 bg-white/[0.02] p-5 transition-colors duration-200 hover:border-vblue/25"
>
  <h3
    class="m-0 mb-1.5 text-[1rem] font-semibold"
    data-i18n={`projects.t${index}.title`}
  >
    {project.title}
  </h3>
  <p
    class="m-0 text-[0.9rem] leading-relaxed text-muted"
    data-i18n={`projects.t${index}.desc`}
  >
    {project.description}
  </p>
  <ul class="m-0 mt-3 flex list-none flex-wrap gap-2 p-0">
    {
      project.stack.map((item) => (
        <li class="inline-flex items-center gap-1.5 rounded-md border border-vblue/10 bg-vblue/10 px-2.5 py-1 text-sm font-medium text-vblue-light">
          {item}
        </li>
      ))
    }
  </ul>
  <a
    class="mt-3 inline-block text-[0.85rem] font-medium text-muted no-underline transition-colors hover:text-vblue-light"
    href={project.href}
    target="_blank"
    rel="noopener"
    data-i18n="projects.link">Visit project</a
  >
</article>
