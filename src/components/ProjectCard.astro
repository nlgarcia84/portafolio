---
import { Image } from "astro:assets";
import type { Project } from "../types";
import translations, { type TranslationKey } from "../i18n/translations";
import Badge from "./ui/Badge.astro";
import Button from "./ui/Button.astro";
import Card from "./ui/Card.astro";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const { en } = translations;
const titleKey = `projects.t${index}.title` as TranslationKey;
const descriptionKey = `projects.t${index}.desc` as TranslationKey;
---

<Card as="article">
  <div class="overflow-hidden border-b border-border bg-accent">
    <Image
      src={project.image}
      alt=""
      width={960}
      widths={[400, 640, 960]}
      sizes="(min-width: 1152px) 516px, (min-width: 768px) 46vw, 90vw"
      format="webp"
      loading="lazy"
      class="aspect-video w-full object-cover object-top"
    />
  </div>
  <div data-slot="card-content" class="flex flex-1 flex-col gap-5 p-6">
    <div class="space-y-2" data-slot="card-header">
      <h3
        data-slot="card-title"
        class="text-xl font-semibold tracking-tight"
        data-i18n={titleKey}
      >
        {en[titleKey]}
      </h3>
      <p
        data-slot="card-description"
        class="leading-relaxed text-muted-foreground"
        data-i18n={descriptionKey}
      >
        {en[descriptionKey]}
      </p>
    </div>
    {
      Object.entries(project.stack).map(
        ([group, items]) =>
          items.length > 0 && (
            <div class="space-y-2">
              <p
                class="text-sm font-medium"
                data-i18n={`projects.stack.${group}`}
              >
                {en[`projects.stack.${group}` as TranslationKey]}
              </p>
              <ul class="flex flex-wrap gap-1.5">
                {items.map((item) => (
                  <Badge as="li">{item}</Badge>
                ))}
              </ul>
            </div>
          ),
      )
    }
    <div class="mt-auto pt-1" data-slot="card-footer">
      <Button
        href={project.href}
        variant="outline"
        target="_blank"
        rel="noopener"
        data-i18n="projects.link"
      >
        {en["projects.link"]}
      </Button>
    </div>
  </div>
</Card>
