---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import khaledhuerta from "../assets/projects/khaledhuerta.png";
import rctechnology from "../assets/projects/rctechnology.png";
import revly from "../assets/projects/revlyapp.png";
import roomy from "../assets/projects/roomyapp.png";
import ProjectCard from "../components/ProjectCard.astro";
import BaseCard from "../components/BaseCard.astro";
import portrait from "../assets/norman_photo.png";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";
import translations from "../i18n/translations";
import type { Project } from "../types";

const skills = [
  "Astro",
  "HTML5",
  "CSS3",
  "JavaScript",
  "TypeScript",
  "React",
  "Node.js",
  "Express",
  "MySQL",
  "MongoDB",
  "Next.js",
  "Tailwind CSS",
  "Supabase",
  "Git/GitHub",
  "REST APIs",
  "Responsive Design",
  "Agile",
  "GitHub Copilot",
  "OpenCode",
];

const projects: Project[] = [
  {
    image: rctechnology,
    stack: {
      frontend: ["Astro", "Tailwind", "TypeScript"],
      backend: ["Supabase"],
      other: [],
    },
    href: "https://www.rctechnology.es/",
  },
  {
    image: roomy,
    stack: {
      frontend: ["Next.js", "Tailwind", "TypeScript"],
      backend: ["Spring Boot", "Java", "Supabase"],
      other: [],
    },
    href: "https://reservesapp-frontend.vercel.app/",
  },
  {
    image: revly,
    stack: {
      frontend: ["Next.js", "Tailwind CSS", "TypeScript"],
      backend: ["Supabase"],
      other: [],
    },
    href: "https://revly.es/",
  },
  {
    image: khaledhuerta,
    stack: {
      frontend: ["Astro", "Tailwind CSS", "TypeScript"],
      backend: [],
      other: [],
    },
    href: "https://www.khaledhuerta.com/",
  },
];

const { en } = translations;
const languages = { es: "Español", ca: "Català", en: "English" };
---

<Layout title={en["meta.title"]} description={en["meta.desc"]}>
  <header class="border-b border-border">
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-5 py-3 sm:px-8"
    >
      <a
        href="#inicio"
        class="text-sm font-semibold uppercase tracking-[0.18em] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
      >
        Norman Leyva
      </a>
      <div class="flex items-center gap-1">
        {
          Object.entries(languages).map(([lang, label]) => (
            <Button
              size="sm"
              variant="ghost"
              data-lang={lang}
              lang={lang}
              aria-label={label}
              aria-pressed={lang === "en"}
            >
              {lang.toUpperCase()}
            </Button>
          ))
        }
      </div>
    </div>
  </header>

  <main id="inicio" class="mx-auto max-w-6xl px-5 sm:px-8">
    <section
      class="grid items-center gap-8 border-b border-border py-12 sm:py-18 md:grid-cols-[1fr_minmax(0,20rem)] lg:py-22"
      aria-labelledby="hero-title"
    >
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-ring">
          <span data-i18n="hero.role">{en["hero.role"]}</span><span
            data-i18n="hero.eyebrow_suffix">{en["hero.eyebrow_suffix"]}</span
          >
        </p>
        <h1
          id="hero-title"
          class="mt-4 text-[clamp(3rem,8vw,6rem)] leading-[0.95] font-semibold tracking-[-0.065em]"
          data-i18n="hero.title"
        >
          {en["hero.title"]}
        </h1>
        <p
          class="mt-5 max-w-lg text-lg leading-relaxed text-muted-foreground"
          data-i18n="hero.lead"
        >
          {en["hero.lead"]}
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <Button href="#proyectos" data-i18n="hero.btn.projects"
            >{en["hero.btn.projects"]}</Button
          >
          <Button
            href="#contacto"
            variant="outline"
            data-i18n="hero.btn.contact">{en["hero.btn.contact"]}</Button
          >
        </div>
      </div>

      <div
        class="w-full max-w-64 overflow-hidden rounded-lg border border-border bg-card md:max-w-none"
      >
        <Image
          src={portrait}
          alt=""
          width={640}
          widths={[320, 640]}
          sizes="(min-width: 768px) 320px, 256px"
          format="webp"
          loading="eager"
          class="aspect-square w-full object-cover grayscale"
        />
      </div>
    </section>

    <section
      id="proyectos"
      class="py-12 sm:py-16"
      aria-labelledby="projects-title"
    >
      <h2
        id="projects-title"
        class="mb-6 text-3xl font-semibold tracking-tight"
        data-i18n="projects.title"
      >
        {en["projects.title"]}
      </h2>
      <div class="grid gap-5 md:grid-cols-2">
        {
          projects.map((project, index) => (
            <ProjectCard project={project} index={index} />
          ))
        }
      </div>
    </section>

    <div class="grid gap-5 pb-12 md:grid-cols-2 sm:pb-16">
      <BaseCard title={en["about.title"]} i18n="about.title">
        <div class="space-y-3 leading-relaxed text-muted-foreground">
          <p>
            <strong class="font-medium text-foreground" data-i18n="about.p1_hl"
              >{en["about.p1_hl"]}</strong
            ><span data-i18n="about.p1_rest">{en["about.p1_rest"]}</span>
          </p>
          <p data-i18n="about.p2">{en["about.p2"]}</p>
          <p>
            <span data-i18n="about.p3_pre">{en["about.p3_pre"]}</span>
            <strong class="font-medium text-foreground" data-i18n="about.p3_hl"
              >{en["about.p3_hl"]}</strong
            ><span data-i18n="about.p3_post">{en["about.p3_post"]}</span>
          </p>
        </div>
      </BaseCard>

      <BaseCard title={en["stack.title"]} i18n="stack.title">
        <ul class="flex flex-wrap gap-2">
          {skills.map((skill) => <Badge as="li">{skill}</Badge>)}
        </ul>
      </BaseCard>
    </div>
  </main>

  <footer id="contacto" class="border-t border-border">
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-end justify-between gap-5 px-5 py-8 sm:px-8"
    >
      <div class="min-w-0">
        <h2
          class="text-xl font-semibold tracking-tight"
          data-i18n="contact.title"
        >
          {en["contact.title"]}
        </h2>
        <p class="mt-2 leading-relaxed text-muted-foreground">
          <span data-i18n="contact.text">{en["contact.text"]}</span>
          <a
            class="break-words text-foreground underline decoration-border underline-offset-4 hover:decoration-ring focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
            href="mailto:nleyvagarcia1@icloud.com">nleyvagarcia1@icloud.com</a
          >
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <Button
          size="sm"
          variant="outline"
          href="https://linkedin.com/in/norman-leyva"
          target="_blank"
          rel="noopener">LinkedIn</Button
        >
        <Button
          size="sm"
          variant="outline"
          href="https://github.com/nlgarcia84"
          target="_blank"
          rel="noopener">GitHub</Button
        >
      </div>
    </div>
  </footer>
</Layout>

<script>
  import translations, {
    type Lang,
    type TranslationKey,
  } from "../i18n/translations";

  const buttons =
    document.querySelectorAll<HTMLButtonElement>("button[data-lang]");
  const translated = document.querySelectorAll<HTMLElement>("[data-i18n]");
  const description = document.querySelector<HTMLMetaElement>(
    'meta[name="description"]',
  );

  function isLanguage(value: string | null | undefined): value is Lang {
    return value === "es" || value === "ca" || value === "en";
  }

  function applyLanguage(lang: Lang) {
    const messages = translations[lang];
    document.documentElement.lang = lang;
    document.title = messages["meta.title"];

    if (description) {
      description.content = messages["meta.desc"];
    }

    for (const element of translated) {
      const key = element.dataset.i18n as TranslationKey;
      element.textContent = messages[key];
    }

    for (const button of buttons) {
      button.setAttribute("aria-pressed", String(button.dataset.lang === lang));
    }
  }

  try {
    const saved = localStorage.getItem("lang");
    if (isLanguage(saved) && saved !== "en") applyLanguage(saved);
  } catch {
    // Some browser privacy settings block local storage.
  }

  for (const button of buttons) {
    button.addEventListener("click", () => {
      const lang = button.dataset.lang;
      if (!isLanguage(lang)) return;

      applyLanguage(lang);
      try {
        localStorage.setItem("lang", lang);
      } catch {
        // The language still applies for this page.
      }
    });
  }
</script>
